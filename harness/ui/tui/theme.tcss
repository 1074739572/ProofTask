/* ── Palette ───────────────────────────────────────────────────
 *  background  #0E1117   surface    #161B22   raised     #1C2129
 *  accent      #5B9BD5   accent-dim #3A6A9E   accent-sub #243A58
 *  success     #8DA6C2   warning    #D4A03C   error      #E05968
 *  success-bg  #202A36   warning-bg #2D2618   error-bg   #2D1B1D
 *  text        #D2D8E0   text-muted #6B7A8D   text-dim   #4A5568
 *  border      #21262D   border-lit #2D3642
 * ────────────────────────────────────────────────────────────── */

Screen {
    layout: vertical;
    background: #0E1117;
}

/* ── top bar ──────────────────────────────────────────────── */
#usage-bar {
    dock: top;
    height: 1;
    background: #243A58;
    color: #C8D6E5;
    padding: 0 1;
}

/* ── chat scroll area ──────────────────────────────────────── */
#chat-pane {
    height: 1fr;
    border: solid #2D3642;
    border-title-color: #6B7A8D;
    padding: 0 1;
    scrollbar-gutter: stable;
}

#chat-stream {
    width: 100%;
    height: auto;
    layout: vertical;
}

/* ── tool / trace cards ────────────────────────────────────── */
.execution-trace {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding: 0 1;
    color: #8899B0;
    background: #161B22;
    border-left: tall #3A6A9E;
}

.execution-trace:hover {
    background: #1C2129;
}

.execution-trace-content {
    width: 100%;
    height: auto;
    padding: 0 0 0 1;
}

.trace-step {
    width: 100%;
    height: auto;
    color: #8899B0;
    margin: 0;
}

.execution-trace .tool-card {
    margin: 0;
}

.tool-card {
    width: 100%;
    height: auto;
    margin: 0 0 0 1;
    color: #6B7A8D;
    border-left: tall #243A58;
}

.tool-card.tool-running {
    color: #7DB9E8;
}

.tool-card.tool-ok {
    color: #8DA6C2;
}

.tool-card.tool-failed,
.tool-card.tool-blocked {
    color: #D4A03C;
}

.tool-card-detail {
    color: #6B7A8D;
    padding: 0 1;
    max-height: 8;
}

/* ── chat messages ─────────────────────────────────────────── */
.chat-user {
    width: 100%;
    height: auto;
    color: #7DB9E8;
    text-style: bold;
    margin: 1 0 0 0;
    padding: 0 1;
}

.chat-user.turn-live {
    color: #A1C8F0;
}

.chat-assistant {
    height: auto;
    margin: 0 0 0 0;
    padding: 0 1;
}

.chat-assistant.turn-live {
    color: #C8D6E5;
}

.chat-error {
    height: auto;
    color: #E05968;
    margin: 0 0 0 0;
    padding: 0 1;
}

.chat-system {
    color: #6B7A8D;
    text-style: italic;
    margin: 1 0;
}

.chat-step {
    color: #6B7A8D;
    margin: 0 0 0 1;
}

/* ── welcome screen ────────────────────────────────────────── */
.welcome-screen {
    width: 100%;
    height: 1fr;
    layout: vertical;
    align: center middle;
    padding: 0 3;
}

.welcome-smiley {
    width: auto;
    height: auto;
    color: #7DB9E8;
    text-style: bold;
    margin: 0 0 1 0;
}

.welcome-hello {
    width: auto;
    height: auto;
    color: #A1C8F0;
    text-style: bold;
    text-align: center;
}

.welcome-tagline {
    width: auto;
    height: auto;
    color: #6B7A8D;
    margin: 0 0 0 0;
    text-align: center;
}

.welcome-narrow {
    color: #A1C8F0;
    text-style: bold;
    margin: 1 0 1 0;
    text-align: center;
}

.welcome-sep {
    width: auto;
    height: 1;
    color: #2D3642;
    margin: 1 0 1 0;
}

.welcome-quote-card {
    width: 100%;
    height: auto;
    margin: 0;
    padding: 0 2;
    border-left: tall #2D3642;
}

.welcome-quote-body {
    width: 100%;
    color: #8899B0;
    margin: 0;
    text-align: center;
}

.welcome-quote-source {
    width: 100%;
    color: #6B7A8D;
    text-align: center;
    margin: 0;
}

/* ── footer / meta / composer ───────────────────────────────── */
#footer-stack {
    dock: bottom;
    height: auto;
    border-top: solid #21262D;
    padding: 0 1 1 1;
}

#meta-bar {
    height: 1;
    margin: 0 0 1 0;
    align: left middle;
}

#meta-model,
#meta-mode {
    color: #5B9BD5;
}

#meta-runtime {
    width: auto;
    color: #6B7A8D;
    margin: 0 1;
}

#meta-status {
    width: 1fr;
    color: #6B7A8D;
    text-align: right;
}

/* ── panels / overlays ─────────────────────────────────────── */
#background-tray {
    display: none;
    height: auto;
    max-height: 7;
    margin: 0 0 1 0;
    padding: 0 1;
    border-left: tall #3A6A9E;
    background: #161B22;
}

#background-title {
    height: 1;
    color: #5B9BD5;
    text-style: bold;
}

#background-list {
    height: auto;
    max-height: 5;
    color: #6B7A8D;
    padding: 0 1;
    background: #0E1117;
    border-left: tall #3A6A9E;
}

#pick-panel {
    height: auto;
    max-height: 14;
    margin: 0 0 1 0;
    background: #161B22;
    border: solid #2D3642;
}

#pick-title {
    height: 1;
    text-style: bold;
    color: #5B9BD5;
    padding: 0 1;
}

#pick-list {
    height: auto;
    max-height: 11;
    padding: 0 1;
}

#pick-hint {
    height: 1;
    color: #6B7A8D;
    padding: 0 1;
}

#interaction-panel {
    display: none;
    height: auto;
    max-height: 16;
    margin: 0 0 1 0;
    padding: 0 1;
    background: #2D2618;
    border: thick #D4A03C;
}

#interaction-title {
    height: 1;
    color: #D4A03C;
    text-style: bold;
}

#interaction-detail {
    height: auto;
    max-height: 5;
    color: #D2D8E0;
    overflow-y: auto;
}

#interaction-input {
    height: 3;
    margin: 1 0 0 0;
}

#interaction-actions {
    height: 3;
    align: right middle;
}

#interaction-actions Button {
    width: 12;
    min-width: 10;
    margin: 0 0 0 1;
}

#command-hints {
    display: none;
    height: 1;
    color: #6B7A8D;
    padding: 0 1;
}

/* ── composer ───────────────────────────────────────────────── */
#user-input {
    width: 100%;
    height: 3;
    min-height: 3;
    max-height: 8;
    border: none;
    border-top: solid #21262D;
    padding: 0 1;
}

#user-input:focus {
    border-top: solid #5B9BD5;
}

/* ── modal ──────────────────────────────────────────────────── */
AllowModal {
    align: center middle;
}

#allow-dialog {
    width: 72;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    background: #161B22;
    border: thick #D4A03C;
    padding: 1 2;
}

#allow-title {
    text-style: bold;
    color: #D4A03C;
    margin-bottom: 1;
}

#allow-detail {
    color: #D2D8E0;
    margin-bottom: 1;
}

#allow-hint {
    color: #6B7A8D;
}
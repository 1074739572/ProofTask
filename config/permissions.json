{
  "version": 2,
  "description": "权限策略。（1）permission 段：V2 声明式 allow/ask/deny 规则表，由 harness.permissions.config 加载，是引擎实际生效的规则；该段存在时不再与内置默认表合并，因此必须完整列出所有需要放行的工具。（2）modes/tools/bash 段：V1 风险分级元数据，由 harness.permission_policy 加载，供会话模式（default / auto-review / full-access）自动放行判定使用。两个消费者读取同一个文件，故两段必须共存。",
  "permission": {
    "*": "ask",
    "external_directory": "allow",
    "read_file": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny"
    },
    "inspect_file": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny"
    },
    "search_text": "allow",
    "git_status": "allow",
    "git_diff": "allow",
    "glob": "allow",
    "todo_write": "allow",
    "load_skill": "allow",
    "compact": "allow",
    "list_tasks": "allow",
    "get_task": "allow",
    "check_inbox": "allow",
    "list_crons": "allow",
    "list_features": "allow",
    "rag_search": "allow",
    "rag_status": "allow",
    "project_status": "allow",
    "verify_command": "allow",
    "web_search": "allow",
    "write_file": {
      "*": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      ".features": "deny",
      ".features/*": "deny",
      "**/.features": "deny",
      "**/.features/*": "deny",
      ".project/goal.json": "deny",
      ".project/goal*": "deny",
      ".project/goal-history/*": "deny",
      "**/.project/goal.json": "deny",
      "**/.project/goal*": "deny",
      "**/.project/goal-history/*": "deny"
    },
    "edit_file": {
      "*": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      ".features": "deny",
      ".features/*": "deny",
      "**/.features": "deny",
      "**/.features/*": "deny",
      ".project/goal.json": "deny",
      ".project/goal*": "deny",
      ".project/goal-history/*": "deny",
      "**/.project/goal.json": "deny",
      "**/.project/goal*": "deny",
      "**/.project/goal-history/*": "deny"
    },
    "patch_file": {
      "*": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.pfx": "deny",
      ".features": "deny",
      ".features/*": "deny",
      "**/.features": "deny",
      "**/.features/*": "deny",
      ".project/goal.json": "deny",
      ".project/goal*": "deny",
      ".project/goal-history/*": "deny",
      "**/.project/goal.json": "deny",
      "**/.project/goal*": "deny",
      "**/.project/goal-history/*": "deny"
    },
    "bash": {
      "*": "ask",
      "dir *": "allow",
      "type *": "allow",
      "where *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "del *": "ask",
      "del /*": "ask",
      "Remove-Item *": "ask",
      "rmdir *": "ask",
      "rm *": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "shutdown*": "deny",
      "reboot*": "deny",
      "mkfs*": "deny",
      "dd if=*": "deny",
      "format *": "deny",
      "*.features*": "deny",
      "*.project/goal.json*": "deny",
      "*.project/goal-history*": "deny"
    },
    "subagent": "allow",
    "task": "allow",
    "spawn_teammate": "allow",
    "mcp__fetch__*": "allow",
    "mcp__playwright__browser_navigate": "allow",
    "mcp__playwright__browser_navigate_back": "allow",
    "mcp__playwright__browser_snapshot": "allow",
    "mcp__playwright__browser_take_screenshot": "allow",
    "mcp__playwright__browser_console_messages": "allow",
    "mcp__playwright__browser_network_requests": "allow",
    "mcp__playwright__browser_wait_for": "allow",
    "mcp__playwright__browser_resize": "allow",
    "mcp__playwright__browser_tabs": "ask",
    "mcp__*": "ask"
  },
  "modes": {
    "default": {
      "label": "默认权限",
      "auto_approve": ["low"]
    },
    "auto-review": {
      "label": "按风险自动放行",
      "auto_approve": ["low", "medium"]
    },
    "full-access": {
      "label": "完全访问权限",
      "auto_approve": ["low", "medium", "high"]
    }
  },
  "tools": {
    "read_file": "low",
    "inspect_file": "low",
    "glob": "low",
    "search_text": "low",
    "rag_search": "low",
    "rag_status": "low",
    "git_status": "low",
    "git_diff": "low",
    "list_tasks": "low",
    "get_task": "low",
    "list_features": "low",
    "project_status": "low",
    "verify_command": "low",
    "load_skill": "low",
    "todo_write": "low",
    "web_search": "low",
    "write_file": "medium",
    "edit_file": "medium",
    "patch_file": "medium",
    "mcp__fetch__*": "low",
    "bash": "high",
    "subagent": "high",
    "task": "low",
    "spawn_teammate": "low"
  },
  "bash": {
    "default_risk": "high",
    "patterns": {
      "blocked": [
        "rm\\s+(-[a-z]*[rR][a-z]*\\s+)*/?\\s*$",
        "\\srm\\s+(-[a-z]*[rR][a-z]*\\s+)*/?\\s*$",
        "shutdown",
        "reboot",
        "mkfs",
        "dd\\s+if=",
        "sudo"
      ],
      "high": [
        "rm\\s+(-[a-z]*[rR]\\s*)?-?[a-z]*f",
        "\\brm\\b"
      ],
      "low": [
        "\\bls\\b",
        "\\bcat\\b",
        "\\bless\\b",
        "\\bmore\\b",
        "\\bhead\\b",
        "\\btail\\b",
        "\\bgrep\\b",
        "\\bfind\\b",
        "\\bwc\\b",
        "\\bgit\\s+status\\b",
        "\\bgit\\s+diff\\b",
        "\\bgit\\s+log\\b",
        "\\bgit\\s+show\\b",
        "\\bgit\\s+ls-files\\b",
        "\\bpwd\\b",
        "\\bwhoami\\b",
        "\\bdate\\b",
        "\\benv\\b",
        "\\bcp\\b",
        "\\bmv\\b",
        "\\bmkdir\\b",
        "\\btouch\\b"
      ]
    }
  }
}
